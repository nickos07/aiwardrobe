{
  "name": "AI Wardrobe Monorepo",
  "image": "python:3.11-bookworm",
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  
  "portsAttributes": {
    "8000": { "label": "FastAPI", "onAutoForward": "notify" },
    "8081": { "label": "Expo", "onAutoForward": "notify" }
  },
  
  "forwardPorts": [8000, 8081],

  "postCreateCommand": "apt-get update && apt-get install -y curl git && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && apt-get install -y nodejs"
}